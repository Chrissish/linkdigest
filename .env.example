# —— 模型（可留空）——
# 留空时不调用任何模型：报告降级为抽取式，同时生成 handoff/ 交接包，
# 可以交给任意 agent 读完补写 answer.json，再 `cli <job> --apply` 应用。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# —— ASR ——
# auto | faster-whisper | mlx-whisper
ASR_ENGINE=auto
# 先用 small 跑通（约 460MB，中文够用）；要质量换 large-v3（约 1.5GB，慢 3-5 倍）
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu
ASR_MAX_SECONDS=14400

# 国内网络建议打开：直连 huggingface.co 常被代理拦成 502
# HF_ENDPOINT=https://hf-mirror.com

# —— 出口代理 ——
# 填了就强制覆盖 shell 里的 HTTP(S)_PROXY，服务只会走这一个出口。
# 不填则沿用启动时继承的环境变量。排查「明明配了代理却连不上」时先看这里。
# 留空＝自动：直连 → 环境变量里的代理 → macOS「系统代理」（scutil 读出）
# 只有需要钉死出口时才填，例如 PROXY_URL=http://127.0.0.1:7897
# PROXY_URL=http://127.0.0.1:7897

# —— 采集 ——
# 难啃平台（YouTube/抖音/小红书/B站高清）需要登录态。
# data/cookies.txt 会被自动采用，不用配 COOKIES_FILE。
# 生成/校验登录态（不装插件、不要磁盘权限）：
#   pbpaste | ./scripts/cookies.sh                  # 从 DevTools 复制的 cookie 头
#   ./scripts/export_cookies.sh --doctor            # 看各浏览器 cookie 库能不能读
COOKIES_FROM_BROWSER=
COOKIES_FILE=
MAX_DOWNLOAD_MB=2048
FETCH_TIMEOUT=30

# —— 分块与成本 ——
LLM_CHUNK_CHARS=6000
LLM_TEMPERATURE=0.2
# 每百万 token 单价（美元），用于成本估算
LLM_PRICE_IN=0.15
LLM_PRICE_OUT=0.60

# —— 路径 ——
FFMPEG_BIN=
LINK_DIGEST_DATA=./data
